# Frontend (Vite) — public values only. Real values live in Vercel:
# Project Settings -> Environment Variables.
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# AI keys are server-side only and must NEVER be added to this file or any
# VITE_ variable (VITE_ values are shipped to the browser).
# They belong in Supabase -> Project Settings -> Edge Functions -> Secrets:
#   GEMINI_API_KEY   read by the shared Gemini helper used by the AI functions
#   OPENAI_API_KEY   optional fallback used by the product-draft AI function
